{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/jayden/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/jayden/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)"],
    "deny": [
      "Edit(/client/**)",
      "Edit(/server/**)",
      "Edit(/.env*)",
      "Edit(/.claude/**)"
    ]
  }
}
